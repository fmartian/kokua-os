<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!-- *NOTE: See also menu_pie_avatar_other.xml -->

<pie_menu
    name="Avatar Pie">
    <pie_slice
        label="Profile..."
        name="Profile...">
        <pie_slice.on_click
            function="ShowAgentProfile"
            parameter="hit object" />
        <pie_slice.on_enable
            function="RLV.EnableIfNot"
            parameter="shownames" />
    </pie_slice>
    <pie_slice
        enabled="false"
        label="Mute"
        name="Avatar Mute">
        <pie_slice.on_click
            function="Avatar.Mute" />
        <pie_slice.on_enable
            function="Avatar.EnableMute" />
    </pie_slice>
    <pie_slice
        enabled="true"
        label="Go to"
        name="Go to">
        <pie_slice.on_click
            function="GoToObject" />
    </pie_slice>
    <pie_slice
        label="Report..."
        name="abuse">
        <pie_slice.on_click
            function="Avatar.ReportAbuse" />
    </pie_slice>
    <pie_menu
        label="Add &gt;"
        name="add_avatar">
        <pie_separator/>
        <pie_separator/>
        <pie_separator/>
        <pie_separator/>
        <pie_slice
            enabled="false"
            label="As Friend..."
            name="Add Friend">
            <pie_slice.on_click
                function="Avatar.AddFriend" />
            <pie_slice.on_enable
                function="Avatar.EnableAddFriend" />
        </pie_slice>
        <pie_slice
            label="To Set..."
            name="Add to Set">
            <pie_slice.on_click
                function="Avatar.AddToContactSet" />
        </pie_slice>
    </pie_menu>
    <pie_slice
        enabled="false"
        label="Pay..."
        name="Pay...">
        <pie_slice.on_click
            function="PayObject" />
        <pie_slice.on_enable
            function="EnablePayAvatar" />
    </pie_slice>
    <pie_menu
        name="Avatar Pie More 1"
        label="More >">
        <pie_slice
            label="Freeze"
            name="Freeze...">
            <pie_slice.on_click
                function="Avatar.Freeze" />
            <pie_slice.on_enable
                function="Avatar.EnableFreezeEject"/>
        </pie_slice>
        <pie_slice
            label="Give Card"
            name="Add Calling Card">
            <pie_slice.on_click
                function="Avatar.AddContact" />
        </pie_slice>
        <pie_slice
            label="Invite to Group"
            name="Group Invite...">
            <pie_slice.on_click
                function="Avatar.InviteToGroup" />
            <pie_slice.on_enable
                function="RLV.EnableIfNot"
                parameter="shownames" />
        </pie_slice>
        <pie_separator />
        <pie_slice
            label="Eject..."
            name="Eject...">
            <pie_slice.on_click
                function="Avatar.Eject" />
            <pie_slice.on_enable
                function="Avatar.EnableFreezeEject"/>
        </pie_slice>
        <pie_slice
            label="Inspect"
            name="Avatar Inspect">
            <pie_slice.on_click
                function="Floater.Show"
                parameter="inspect" />
            <pie_slice.on_enable
                function="Object.EnableInspect" />
        </pie_slice>
        <pie_menu
            name="Avatar Pie More 2"
            label="More >">
            <!-- ## Zi: Is this the right thing to use for avatar textures? -->
            <pie_slice
                label="Textures"
                name="Debug...">
                <pie_slice.on_click
                    function="Avatar.Debug" />
            </pie_slice>
            <pie_slice
                label="Attachments"
                name="Attachment List">
                <pie_slice.on_click
                    function="Avatar.AttachmentList" />
            </pie_slice>
            <pie_slice
                label="Call"
                name="Call">
                <pie_slice.on_click
                    function="Avatar.Call" />
                <pie_slice.on_enable
                    function="Avatar.EnableCall" />
            </pie_slice>
            <pie_slice
                label="Zoom In"
                name="Zoom In">
                <pie_slice.on_click
                    function="Tools.LookAtSelection"
                    parameter="zoom" />
            </pie_slice>
            <pie_slice
                enabled="true"
                label="Tex Refresh"
                name="Texture Refresh">
                <pie_slice.on_click
                    function="Object.TexRefresh" />
            </pie_slice>
            <pie_menu
                name="ResetMenu"
                label="Reset &gt;">
                <pie_slice
                    label="Skel. &amp; Anim."
                    name="Reset Skeleton And Animations">
                    <pie_slice.on_click
                        function="Avatar.ResetSkeletonAndAnimations" />
                </pie_slice>
                <pie_slice
                    label="Skeleton"
                    name="Reset Skeleton">
                    <pie_slice.on_click
                        function="Avatar.ResetSkeleton" />
                </pie_slice>
            </pie_menu>
	          <pie_slice
                enabled="false"
                label="Export"
                name="Export">
                <pie_slice.on_click
                    function="Object.Export" />
                <pie_slice.on_enable
                    function="Object.EnableExport" />
            </pie_slice>
					  <pie_menu
						    name="RenderMenu"
						    label="Render &gt;">
                <pie_slice
                    name="RenderNormally"
                    label="Render Normal">
                    <pie_slice.on_click
                        function="Avatar.SetImpostorMode"
                        parameter="0" />
                </pie_slice> 
                <pie_slice
                    name="DoNotRender"
                    label="Do Not Render">
                    <pie_slice.on_click
                        function="Avatar.SetImpostorMode"
                        parameter="1" />
                </pie_slice>
                <pie_slice
                    name="AlwaysRenderFully"
                    label="Render Fully">
                    <pie_slice.on_click
                        function="Avatar.SetImpostorMode"
                        parameter="2" />
                </pie_slice>
                <pie_slice
                    name="Exceptions"
                    label="Exceptions...">
                    <pie_slice.on_click
                        function="View.Blocked"
                        parameter="avatar_rendering_tab" />
                </pie_slice>
						</pie_menu>
        </pie_menu>
        <pie_slice
            enabled="true"
            label="Derender"
            name="Derender">
            <pie_slice.on_click
                function="Object.Derender" />
        </pie_slice>
    </pie_menu>
    <pie_slice
        label="IM"
        name="Send IM...">
        <pie_slice.on_click
            function="Avatar.SendIM" />
        <pie_slice.on_enable
            function="RLV.EnableIfNot"
            parameter="shownames" />
    </pie_slice>
</pie_menu>
